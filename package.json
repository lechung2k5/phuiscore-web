{
  "name": "phuiscore-web",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "native:prebuild": "cd apps/expo && yarn prebuild",
    "ios": "cd apps/expo && yarn ios",
    "android": "cd apps/expo && yarn android",
    "watch": "ultra -r --no-pretty --concurrency 400 watch",
    "vercel:install": "yarn set version 3.5 && yarn install",
    "web": "yarn build && cd apps/next && yarn dev",
    "web:extract": "DISABLE_EXTRACTION=false yarn workspace next-app dev",
    "web:prod": "yarn workspace next-app build",
    "web:prod:serve": "yarn workspace next-app serve",
    "postinstall": "yarn check-tamagui",
    "build": "yarn workspace next-app build",
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "check-tamagui": "tamagui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "tamagui": "2.0.0-rc.0",
    "@tamagui/core": "2.0.0-rc.0",
    "@tamagui/web": "2.0.0-rc.0",
    "react-native-web": "0.19.10",
    "metro": "0.84.4",
    "metro-resolver": "0.84.4"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "@tamagui/cli": "2.0.0-rc.0",
    "@tamagui/core": "2.0.0-rc.0",
    "@tamagui/react-native-svg": "2.0.0-rc.0",
    "@tamagui/react-native-web-lite": "2.0.0-rc.0",
    "check-dependency-version-consistency": "^4.1.0",
    "dotenv": "^17.4.2",
    "got-scraping": "3.2.15",
    "husky": "^9.1.6",
    "puppeteer": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io-client": "^4.7.5",
    "tamagui": "2.0.0-rc.0",
    "tesseract.js": "^7.0.0",
    "turbo": "^1.13.4",
    "typescript": "~5.8.3",
    "ultra-runner": "^3.10.5",
    "vitest": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@types/node": "^25.0.10",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1"
  }
}
